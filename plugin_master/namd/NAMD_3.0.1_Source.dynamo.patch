--- NAMD_3.0.1_Source/src/GlobalMasterDY.C	1969-12-31 19:00:00.000000000 -0500
+++ NAMD_3.0.1_Source/src/GlobalMasterDY.C	2025-03-27 18:15:57.985627227 -0400
@@ -0,0 +1,237 @@
+#ifndef __BINDC
+#define __BINDC
+#endif
+
+#include "InfoStream.h"
+#include "NamdTypes.h"
+#include "Node.h"
+#include "Molecule.h"
+#include "Lattice.h"
